{
  "name": "gm-vocabulary-workspace",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "ng": "ng",
    "start": "nx serve gm-vocabulary --host 0.0.0.0 --port 4200",
    "build": "nx run-many -t build -p gm-vocabulary api",
    "watch": "nx build gm-vocabulary --watch --configuration development",
    "server": "nx serve api --configuration=production",
    "start:server": "nx serve api",
    "graph": "nx graph",
    "test": "nx run-many -t test -p gm-vocabulary api",
    "test:api:e2e": "vitest run --config apps/api/vitest.config.e2e.mts",
    "test:ci": "nx test gm-vocabulary --watch=false && nx test api --run",
    "e2e": "nx e2e gm-vocabulary-e2e",
    "e2e:ui": "nx e2e gm-vocabulary-e2e --configuration=ui",
    "e2e:headed": "nx e2e gm-vocabulary-e2e --configuration=headed",
    "lint": "nx run-many -t lint -p gm-vocabulary api gm-vocabulary-e2e",
    "typecheck": "ngc --noEmit -p apps/gm-vocabulary/tsconfig.app.json && tsc --noEmit -p apps/gm-vocabulary/tsconfig.spec.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@ngrx/signals": "^22.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^9.7.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.5",
    "@angular-devkit/schematics": "^22.1.5",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nx/angular": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@playwright/test": "^1.62.1",
    "@schematics/angular": "^22.1.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "~4.1.0",
    "angular-eslint": "22.2.0",
    "eslint": "^10.6.0",
    "jsdom": "^27.1.0",
    "nx": "23.2.0",
    "postcss": "^8.5.3",
    "prettier": "~3.6.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
