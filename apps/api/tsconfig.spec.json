{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "vitest.config.mts",
    "vitest.config.e2e.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "test/**/*.ts"
  ]
}
